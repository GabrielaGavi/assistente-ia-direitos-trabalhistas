# Copie para `backend/.env` e ajuste conforme o seu ambiente.
# O arquivo .env NAO deve ser versionado (ja coberto pelo .gitignore).

# --- Banco de dados ---------------------------------------------------------
# Desenvolvimento local via docker compose (ver docker-compose.yml na raiz).
# O driver asyncpg exige o prefixo `postgresql+asyncpg://`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/assistente_trabalhista

# Banco usado pelos testes de integracao. A suite cria e destroi tabelas aqui,
# entao NUNCA aponte para o banco de desenvolvimento ou de producao.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/assistente_trabalhista_test

# Emite no log todo SQL gerado pelo SQLAlchemy. Util para depurar, ruidoso no dia a dia.
DATABASE_ECHO=false

# --- Aplicacao --------------------------------------------------------------
APP_ENV=development

# --- Inteligencia Artificial (Groq) ------------------------------------------
# Gere a chave em https://console.groq.com/keys. Nunca versione o valor real.
GROQ_API_KEY=

# Modelo usado nas chamadas de classificacao e geracao de resposta. O padrao
# ("openai/gpt-oss-20b") suporta Structured Outputs em modo "strict" na Groq,
# exigido pela classificacao de documentos; nem todo modelo suporta -- ver
# https://console.groq.com/docs/structured-outputs e /docs/models antes de
# trocar.
GROQ_MODEL=openai/gpt-oss-20b
